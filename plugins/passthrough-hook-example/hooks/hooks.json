{
  "description": "Bootstrap example: a PreToolUse hook that does nothing but pass through.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/passthrough.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
