{
  "description": "Behavior guardrail hooks for Claude Code sessions.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/no-command-chaining.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/no-git-mutations.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
